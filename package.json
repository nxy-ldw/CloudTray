{
  "name": "cloudtray",
  "productName": "云屉",
  "version": "1.3.0",
  "description": "云屉 CloudTray - 桌面收纳窗口 / 中转站 / Dock 栏",
  "main": "src/main/main.js",
  "author": {
    "name": "CloudTray Studio",
    "email": "support@cloudtray.local"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win --publish never && node scripts/rename-artifacts.js",
    "pack": "node scripts/make-icon.js && electron-builder --win --dir --publish never",
    "rename": "node scripts/rename-artifacts.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  }
}
